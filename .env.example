# SignBridge — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

SECRET_KEY=django-insecure-changeme-generate-a-real-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
DATABASE_URL=sqlite:///db.sqlite3

# Fichiers médias
MEDIA_ROOT=media/
MEDIA_URL=/media/

# Sécurité (production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
